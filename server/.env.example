# Эти значения используются при локальном запуске (npm run dev).
# В Docker переменные приходят из docker-compose.yml и этот файл не читается.

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USER=mellcoin
DB_PASSWORD=mellcoin
DB_NAME=mellcoin

# Автосоздание схемы БД. Для реального прода — false + миграции TypeORM
DB_SYNCHRONIZE=true

# Смените в проде на длинную случайную строку
JWT_SECRET=dev_super_secret_change_me
JWT_EXPIRES_IN=30d
COOKIE_NAME=mell_token

# secure=true браузер примет только по HTTPS; при secure=true нужен samesite=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Тестовая админка на /api/admin — БЕЗ АВТОРИЗАЦИИ.
# На боевом сервере должно быть false или переменной вообще не должно быть.
ADMIN_ENABLED=true

# Origin фронтенда (для CORS + cookie)
CLIENT_ORIGIN=http://localhost:5173
